# ============================================================
# .env.example — Variables d'environnement du projet
# ============================================================
# IMPORTANT : Ce fichier est un EXEMPLE. Il est commité dans Git.
# Copier ce fichier en .env et remplir les vraies valeurs :
#     cp .env.example .env
# Le fichier .env est dans .gitignore : jamais de secrets dans Git.
# ============================================================

# --- Clés API des fournisseurs météo ---
# Obtenir gratuitement sur https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Obtenir gratuitement sur https://www.weatherapi.com/
WEATHERAPI_KEY=your_weatherapi_key_here

# Open-Meteo ne nécessite pas de clé API (gratuit et sans auth)

# --- Configuration Redis ---
# En local sans Docker : redis://localhost:6379
# En Docker Compose : redis://redis:6379 (nom du service)
REDIS_URL=redis://redis:6379

# --- Configuration de l'application ---
# Nombre de villes à pré-chauffer dans le cache toutes les 10 min
TOP_CITIES_COUNT=20

# Délai max d'attente pour un fournisseur météo (en secondes)
PROVIDER_TIMEOUT=5

# Nombre d'erreurs consécutives avant d'ouvrir le circuit breaker
CIRCUIT_BREAKER_THRESHOLD=3

# Durée pendant laquelle le circuit reste ouvert (en secondes)
CIRCUIT_BREAKER_RECOVERY=30
