# ============================================================
# .env.example — Variables d'environnement du projet
# ============================================================
# IMPORTANT : Ce fichier est un EXEMPLE commité dans Git.
# Copier ce fichier en .env et renseigner les vraies valeurs :
#     cp .env.example .env
# Le fichier .env est dans .gitignore : les secrets ne transitent jamais dans Git.
# ============================================================

# --- Clés API des fournisseurs météo ---
# Obtenir gratuitement sur https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Obtenir gratuitement sur https://www.weatherapi.com/
WEATHERAPI_KEY=your_weatherapi_key_here

# Open-Meteo ne nécessite pas de clé API (100 % gratuit et sans authentification)

# --- Configuration Redis ---
# En local sans Docker : redis://localhost:6379
# En Docker Compose  : redis://redis:6379 (le service s'appelle "redis" dans docker-compose.yml)
REDIS_URL=redis://redis:6379

# --- Cache Redis ---
# Durée de vie du cache court (données brutes par fournisseur) — en secondes
CACHE_COURT_TTL=300

# Durée de vie du cache long (réponse consolidée) — en secondes
CACHE_LONG_TTL=3600

# --- Circuit breaker ---
# Nombre d'erreurs dans la fenêtre glissante avant ouverture du circuit
CIRCUIT_BREAKER_THRESHOLD=3

# Durée pendant laquelle le circuit reste ouvert avant de repasser en HALF_OPEN — en secondes
CIRCUIT_BREAKER_RECOVERY=30

# Fenêtre glissante de comptage des erreurs — en secondes
CIRCUIT_BREAKER_WINDOW=60

# --- Scheduler (pré-chauffe automatique du cache) ---
# Nombre de villes populaires à pré-chauffer automatiquement
TOP_CITIES_COUNT=20

# Intervalle entre deux sessions de pré-chauffe — en minutes
SCHEDULER_INTERVAL_MINUTES=10

# Délai max d'attente pour la réponse d'un fournisseur météo — en secondes
PROVIDER_TIMEOUT=5

# --- CORS ---
# Origines autorisées à interroger l'API depuis un navigateur.
# Plusieurs valeurs séparées par une virgule.
# En production, remplacer par l'URL réelle du frontend.
CORS_ORIGINS=http://localhost:8000

# --- Sécurité réseau ---
# Mettre à true uniquement si l'app est derrière un reverse proxy de confiance
# (nginx, Railway, Render…). Permet de lire X-Forwarded-For pour le rate limiting.
TRUSTED_PROXY=false
