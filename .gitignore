# ============================================================
# .gitignore — Fichiers à ne PAS commiter dans Git
# ============================================================

# Variables d'environnement (secrets réels, jamais dans Git !)
.env

# Cache Python (bytecode compilé, inutile dans Git)
__pycache__/
*.pyc
*.pyo
*.pyd

# Environnement virtuel Python
venv/
.venv/
env/

# Cache pytest et couverture de code
.pytest_cache/
.coverage
htmlcov/

# Fichiers IDE (VS Code, PyCharm...)
.vscode/
.idea/
*.swp

# Fichiers macOS
.DS_Store

# Logs
*.log

# Doc perso / soutenance (hors cahier des charges Git)
DOCUMENTATION_SOUTENANCE.md
GUIDE_DEMO.md
GUIDE_DEMO_POSTMAN.md
RECAP_LIVRABLES.md
docs/

# Outils locaux
postman/

# Livrables générés (rendus hors dépôt)
generer_presentation.py
generer_rapport.py
presentation.pptx
rapport_technique.docx
RAPPORT PROJET 05 AGREGATEUR METEO.docx
RAPPORT PROJET 05 AGREGATEUR METEO.pdf

# Fichiers Office temporaires
~$*
*.tmp